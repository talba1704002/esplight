# ---- Target / flash -------------------------------------------------------
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# ---- CPU / RTOS -----------------------------------------------------------
# Matter + Wi-Fi + BLE need >=160 MHz (80 MHz is not offered).
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# Needed for the runtime 160/240 MHz switch (esp_pm_configure, no light sleep).
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# ---- Bluetooth (NimBLE) for commissioning --------------------------------
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_EXT_ADV=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_PINNED_TO_CORE_1=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_ENABLE_CHIPOBLE=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=5120

# ---- Matter over Wi-Fi ----------------------------------------------------
CONFIG_ENABLE_WIFI_STATION=y
# Matter's own SoftAP is OFF: our ap_manager owns the "LIGHT" access point.
CONFIG_ENABLE_WIFI_AP=n
CONFIG_USE_MINIMAL_MDNS=y
CONFIG_ENABLE_MATTER_OVER_THREAD=n
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_ENABLE_CHIP_SHELL=n

# ---- Development identity (test VID/PID + built-in test DAC) -------------
CONFIG_DEVICE_VENDOR_ID=0xFFF1
CONFIG_DEVICE_PRODUCT_ID=0x8000
CONFIG_DEVICE_TYPE_ON_OFF_LIGHT=y
CONFIG_ENABLE_ESP32_FACTORY_DATA_PROVIDER=n

# ---- Production identity (uncomment, flash mfg-tool output to 'fctry') ---
# CONFIG_ENABLE_ESP32_FACTORY_DATA_PROVIDER=y
# CONFIG_ENABLE_ESP32_DEVICE_INSTANCE_INFO_PROVIDER=y
# CONFIG_SEC_CERT_DAC_PROVIDER=1
# CONFIG_FACTORY_PARTITION_DAC_PROVIDER=y
# CONFIG_CHIP_FACTORY_NAMESPACE_PARTITION_LABEL="nvs"
# CONFIG_FACTORY_PARTITION_LABEL="fctry"

# ---- HTTP server / misc --------------------------------------------------
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=256
CONFIG_MBEDTLS_HKDF_C=y
